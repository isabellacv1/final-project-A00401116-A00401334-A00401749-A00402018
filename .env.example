# Plantilla de configuración local (HU-34).
#
#   cp .env.example .env
#   docker compose -f docker-compose.dev.yml -f docker-compose.app.yml up -d --build
#
# .env está en .gitignore y nunca se versiona. Este archivo solo declara las claves:
# completa los secretos con valores propios, nunca con los de stage o prod.
#
# Para ejecutar un servicio con Gradle (bootRun) carga el archivo antes:
#   Git Bash:    set -a; source .env; set +a
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '^\w' } | ForEach-Object {
#                  $k, $v = $_ -split '=', 2; [Environment]::SetEnvironmentVariable($k, $v) }

# --- Configuración dependiente del ambiente (no sensible) ---
LOG_LEVEL=DEBUG
JWT_EXPIRATION=3600000
QR_EXPIRATION=60000
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8080

# --- Secretos de desarrollo (obligatorios, sin valor por defecto) ---
# El JWT y el QR exigen al menos 32 caracteres: openssl rand -base64 48
JWT_SECRET=
QR_SECRET=
# Credenciales de datos del compose local
DB_USERNAME=admin
DB_PASSWORD=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
LDAP_PASSWORD=
# Claves del vault de identidad (hexadecimales)
VAULT_SECRET=
VAULT_SALT=
VAULT_HASH_SALT=
