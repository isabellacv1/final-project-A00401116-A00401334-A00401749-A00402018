    {
      "type": "stat",
      "title": "Failed logins (24 h)",
      "description": "A sudden increase may be a password guessing attempt.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum(increase(http_server_requests_seconds_count{application=\"circleguard-auth-service\",uri=\"/api/v1/auth/login\",status=\"401\"}[24h]))) or vector(0)",
          "legendFormat": "",
          "refId": "A"
