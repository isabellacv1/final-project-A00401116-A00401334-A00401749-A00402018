# ==============================================================================
# Credenciales para exportar/aplicar la configuración de Jenkins, SonarQube y
# Nexus.  COPIE este archivo a `.env` y reemplace los valores.
#
#   cp infra/config-as-code/.env.example infra/config-as-code/.env
#
# `.env` está en .gitignore: NUNCA se sube al repositorio.
# ==============================================================================

# --- Jenkins (cg-devops) -----------------------------------------------------
JENKINS_URL=http://100.31.132.57:8080
JENKINS_USER=admin
JENKINS_PASSWORD=REEMPLAZAR

# Credenciales que viven dentro de Jenkins (se exportan como ${ENV:...})
GIT_USERNAME=REEMPLAZAR
GIT_PASSWORD=REEMPLAZAR
NEXUS_PUBLISHER_USERNAME=ci-publisher
NEXUS_PUBLISHER_PASSWORD=REEMPLAZAR
SONARQUBE_TOKEN=REEMPLAZAR

# --- SonarQube (cg-sonarqube) ------------------------------------------------
SONARQUBE_URL=http://100.31.132.57:9092
SONARQUBE_USER=admin
SONARQUBE_PASSWORD=REEMPLAZAR

# Configuración deseada de SonarQube (calidad como código)
SONARQUBE_QUALITY_GATE=circle-guard
SONARQUBE_PROJECT_KEY=circleGuard
SONARQUBE_WEBHOOK_NAME=Jenkins-Webhook
SONARQUBE_WEBHOOK_URL=http://10.20.1.230:8080/sonarqube-webhook/

# --- Nexus (cg-devops) -------------------------------------------------------
NEXUS_URL=http://100.31.132.57:8081
NEXUS_USER=admin
NEXUS_PASSWORD=REEMPLAZAR

# Usuarios creados por configure-nexus.sh (solo se usan si no existen aún)
NEXUS_CI_PUBLISHER_PASSWORD=REEMPLAZAR
NEXUS_DEPLOY_READER_PASSWORD=REEMPLAZAR

# --- Despliegue remoto (para bootstrap-all.sh) -------------------------------
# Instancias EC2 y llave SSH que abre las dos máquinas de CI/CD.
CI_DEVOPS_HOST=100.31.132.57
CI_SONARQUBE_HOST=100.31.132.57
CI_SSH_USER=ubuntu
CI_SSH_KEY=~/.ssh/cg-devops-key.pem
