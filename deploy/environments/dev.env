# Environment: dev
# Deployed automatically by the pipeline on the "dev" branch (HU-13).
#
# This file only carries NON-SENSITIVE configuration. Secrets (passwords, JWT/QR
# signing keys, vault keys) live in deploy/secrets/dev-secrets.env, which is not
# versioned. On the host both files are merged into the `.env` file Compose reads
# (see deploy/README.md, "Secrets on the host").
HOST=54.83.254.142
SSH_USER=ubuntu
# The hosts pull from the public address of the Nexus docker registry (8082).
REGISTRY=100.31.132.57:8082
SPRING_PROFILES_ACTIVE=dev
WEB_HOST=54.83.254.142

# --- Behaviour that changes per environment (HU-34) ---
# DEBUG while developing; the same image runs with INFO in stage and WARN in prod.
LOG_LEVEL=DEBUG
# Long sessions while developing (milliseconds).
JWT_EXPIRATION=7200000
# QR validity when a visitor validates the code at the gate (milliseconds).
QR_EXPIRATION=60000

# --- Data endpoints inside the Docker network ---
DB_HOST=postgres
DB_PORT=5432
