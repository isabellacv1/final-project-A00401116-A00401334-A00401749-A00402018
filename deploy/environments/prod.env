# Environment: prod
# Promoted from stage in the version promotion flow (HU-14).
#
# This file only carries NON-SENSITIVE configuration. Secrets live in
# deploy/secrets/prod-secrets.env, which is not versioned.
HOST=98.92.231.157
SSH_USER=ubuntu
REGISTRY=100.31.132.57:8082
SPRING_PROFILES_ACTIVE=prod
