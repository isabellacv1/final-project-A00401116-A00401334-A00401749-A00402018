LOG_LEVEL=WARN
# Shorter sessions than stage (milliseconds).
JWT_EXPIRATION=1800000
QR_EXPIRATION=60000

# --- Data endpoints inside the Docker network ---
DB_HOST=postgres
DB_PORT=5432
