#!/usr/bin/env bash
# Validates the commit message against Conventional Commits.
# Enable once per clone: git config core.hooksPath .githooks
# Full convention: docs/CONTRIBUTING.md

msg_file="$1"
header="$(head -n 1 "$msg_file")"

# Allow git-generated messages (merges, reverts, fixups).
if [[ "$header" =~ ^(Merge|Revert\ \"|fixup!|squash!) ]]; then
  exit 0
fi

types='feat|fix|perf|refactor|docs|test|build|ci|chore|style|revert'
pattern="^(${types})(\([a-z0-9-]+\))?!?: [a-z0-9].*[^.]$"

if [[ ! "$header" =~ $pattern ]]; then
  echo "ERROR: invalid commit message:"
  echo "  $header"
  echo
  echo "Expected: <type>(<scope>): <subject>"
  echo "  types:   ${types//|/, }"
  echo "  subject: lowercase start, imperative mood, no final period"
  echo "  example: feat(promotion): add status cascade with 14-day ttl"
  echo
  echo "See docs/CONTRIBUTING.md"
  exit 1
fi

if (( ${#header} > 100 )); then
  echo "ERROR: commit header is ${#header} characters long (max 100)."
  exit 1
fi
